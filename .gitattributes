# Shader sources are embedded verbatim into a generated header, and
# VineEmbedShaders.cmake rejects CR bytes because the embedded text must match the
# file on disk byte for byte. Force LF in the working tree so a Windows checkout
# with core.autocrlf=true cannot break the build.
*.vert text eol=lf
*.frag text eol=lf
*.comp text eol=lf
*.geom text eol=lf
*.tesc text eol=lf
*.tese text eol=lf

# The evidence baseline is compared line by line against a run by
# scripts/vsg_selftest_evidence.sh, and that script is bash: a CRLF checkout would
# make every baseline line differ and every script line a syntax error. Same
# reason as the shaders above: the working tree has to match what the tool reads.
scripts/vsg_selftest_evidence.txt text eol=lf
*.sh text eol=lf

# The public-docs baseline is data written back by scripts/check_public_docs.py
# --update and read line by line by the gate. LF keeps that write byte-identical on
# every platform, so a Windows checkout cannot turn the whole file into a diff.
scripts/public_docs_baseline.txt text eol=lf
